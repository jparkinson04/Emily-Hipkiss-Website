<form class="form" id="contact-form" novalidate>
  <!-- Honeypot: humans never see this, bots fill it in -->
  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <h2>Send a message</h2>

  <div class="field">
    <label for="name">Your name</label>
    <input id="name" name="name" type="text" required autocomplete="name" />
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email" />
  </div>
  <div class="field">
    <label for="phone">Phone <span class="optional">(optional)</span></label>
    <input id="phone" name="phone" type="tel" autocomplete="tel" />
  </div>
  <div class="field">
    <label for="message">Your message</label>
    <textarea id="message" name="message" required aria-describedby="message-help" placeholder="As much or as little as you like."></textarea>
    <p id="message-help" class="help">If enquiring about booking a consultation call, please include your availability and preferred method (phone/video).</p>
  </div>

  <div class="form__foot">
    <button class="btn" type="submit">Send message</button>
    <p class="form__note">Only used to reply to you. <a href="/privacy">Privacy notice</a>.</p>
  </div>
  <p class="form__error" id="form-error" hidden>
    Sorry, something went wrong sending your message. You can email me directly at
    <a href="mailto:emilyhipkisscounselling@outlook.com">emilyhipkisscounselling@outlook.com</a>.
  </p>
  <p class="form__next">We'll start with a free 20-minute consultation call by phone or video.</p>
</form>

<div class="form form--sent" id="form-success" hidden>
  <h2>Thank you</h2>
  <p class="form__sent-text">Your message has been sent. I'll reply on one of my working days.</p>
</div>

<script>
  // Runs on first load and after every client-side navigation (ClientRouter), so the form always has its handler
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("form-success");
    const error = document.getElementById("form-error");
    if (!form || !success || !error) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      error.hidden = true;

      const button = form.querySelector("button");
      if (button) { button.disabled = true; button.textContent = "Sending..."; }

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error();
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ block: "center", behavior: "smooth" });
      } catch {
        error.hidden = false;
        if (button) { button.disabled = false; button.textContent = "Send message"; }
      }
    });
  });
</script>

<style>
.form[hidden] { display: none !important; }
  .form { display: grid; gap: 30px; max-width: 520px; margin: 0 auto; width: 100%; }
  h2 { font-size: 30px; margin: 0; }
  .field { display: grid; gap: 4px; }
  label { font-size: 16px; font-weight: 600; }
  .optional { font-weight: 400; color: var(--muted); }
  input, textarea {
    font: inherit; font-size: 18px; color: var(--bark); width: 100%;
    background: transparent; border: 0; border-bottom: 1.5px solid color-mix(in srgb, var(--bark) 35%, transparent);
    border-radius: 0; padding: 10px 0;
  }
  textarea { min-height: 140px; resize: vertical; }
  ::placeholder { color: var(--muted); opacity: 1; }
  input:focus-visible, textarea:focus-visible { outline: none; box-shadow: none; border-bottom: 2px solid var(--sage-deep); padding-bottom: 9.5px; }
  .help { font-size: 15px; color: var(--muted); margin: 8px 0 0; }
  .hidden { display: none; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .form__foot .btn { cursor: pointer; font-family: inherit; font-size: 1rem; min-height: 48px; }
  .form__foot .btn:disabled { opacity: .6; cursor: default; }
  .form__note { flex: 1 1 12rem; font-size: 15px; color: var(--muted); margin: 0; }
  .form__note a { color: var(--bark); }
  .form__error { font-size: 15px; color: var(--bark); margin: 0; }
  .form__error a { color: var(--bark); }
  .form__sent-text { font-size: 18px; color: var(--bark); margin: 0; }
  .form__next { font-size: 16px; color: var(--muted); margin: 0; padding-top: 18px; border-top: 1px solid var(--hairline); }
  @media (max-width: 900px) {
    .form { gap: 22px; }
    h2 { font-size: 26px; }
    input, textarea { min-height: 48px; }
    .form__foot { flex-direction: column; align-items: stretch; gap: 12px; }
    .form__foot .btn { width: 100%; min-height: 52px; text-align: center; }
    .form__note { flex: none; text-align: center; }
    .form__next { display: none; }
  }
</style>