---
import Monogram from './Monogram.astro';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/outdoor-therapy', label: 'Walk & Talk' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" transition:name="brand">
      <Monogram size={44} />
      <span class="brand__text">
        <span class="brand__name">Emily Hipkiss</span>
        <span class="brand__sub">Counselling &amp; Therapy</span>
      </span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
    <nav id="site-nav" aria-label="Main" transition:name="nav">
      <ul class="nav">
        {links.map(l => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- Without JS the button stays hidden and the nav simply wraps beneath the brand. -->
<script is:inline data-astro-rerun>
  (() => {
    const header = document.querySelector('.site-header');
    const toggle = header.querySelector('.menu-toggle');
    header.classList.add('has-js');
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
    });
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  })();
</script>

<style>
  .site-header { background: var(--cream); border-top: 4px solid var(--sage); border-bottom: 1px solid var(--hairline); }
  .site-header__inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding-block: var(--space-3) var(--space-2); }
  .brand { display: flex; align-items: center; gap: var(--space-2); text-decoration: none; color: var(--bark); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__name { font-family: var(--font-heading); font-size: 1.375rem; }
  .brand__sub { font-size: 0.9375rem; font-variant-caps: all-small-caps; letter-spacing: 0.12em; color: var(--sage-deep); }
  .nav { list-style: none; display: flex; justify-content: center; gap: var(--space-1) var(--space-4); margin: 0; padding: 0; flex-wrap: wrap; }
  .nav a { display: inline-block; text-decoration: none; color: var(--bark); font-size: 1rem; font-weight: 600; padding-block: 0.25rem; border-bottom: 2px solid transparent; transition: border-color .2s; }
  .nav a:hover { border-bottom-color: var(--sage); }
  .nav a[aria-current="page"] { border-bottom-color: var(--sage-deep); }

  .menu-toggle { display: none; }

  /* Contact page: header sits in the top-left of the sage panel, all cream */
  :global([data-page="contact"]) .site-header { position: absolute; top: 0; left: 0; z-index: 2; padding: 22px 56px; background: transparent; border: 0; }
  :global([data-page="contact"]) .site-header__inner { width: auto; align-items: flex-start; padding: 0; }
  :global([data-page="contact"]) .brand, :global([data-page="contact"]) .brand__sub, :global([data-page="contact"]) .nav a { color: var(--cream); }
  :global([data-page="contact"]) .brand :global(circle) { stroke: var(--cream); }
  :global([data-page="contact"]) .brand :global(text) { fill: var(--cream); }
  :global([data-page="contact"]) .nav { justify-content: flex-start; }
  :global([data-page="contact"]) .nav a:hover { border-bottom-color: var(--sage); }
  :global([data-page="contact"]) .nav a[aria-current="page"] { border-bottom-color: var(--cream); }
  :global([data-page="contact"]) :focus-visible { outline-color: var(--cream); }
  @media (max-width: 900px) {
    :global([data-page="contact"]) .site-header { right: 0; padding: 10px 24px; }
    :global([data-page="contact"]) .site-header__inner { width: 100%; align-items: center; }
    /* Open menu on the Contact page: solid sage panel so the links sit cleanly over the hero */
    :global([data-page="contact"]) .site-header:has(.menu-toggle[aria-expanded="true"]) { background: var(--sage-deep); border-bottom: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); padding-bottom: 12px; }
    :global([data-page="contact"]) .has-js .nav { padding-top: 8px; }
    :global([data-page="contact"]) .nav { justify-content: center; }
  }

  @media (max-width: 760px) {
    .site-header__inner { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-1) var(--space-2); padding-block: 10px; }
    .brand { gap: 0.6rem; }
    .brand :global(svg) { width: 36px; height: 36px; }
    .brand__name { font-size: 1.2rem; }
    .brand__sub { font-size: 0.8125rem; }
    .nav { gap: var(--space-1) var(--space-3); }

    .has-js .menu-toggle {
      display: inline-block; font: inherit; font-size: 1rem; font-weight: 600; color: var(--bark);
      background: transparent; border: 1px solid var(--bark-soft); border-radius: var(--radius-pill);
      padding: 0.4em 1.1em; cursor: pointer;
    }
    .has-js .menu-toggle:hover, .has-js .menu-toggle[aria-expanded="true"] { background: var(--sage-tint); }
    :global([data-page="contact"]) .has-js .menu-toggle { color: var(--cream); border-color: var(--cream); }
    :global([data-page="contact"]) .has-js .menu-toggle:hover, :global([data-page="contact"]) .has-js .menu-toggle[aria-expanded="true"] { background: var(--sage); color: var(--bark); }
    :global([data-page="contact"]) .has-js .nav li + li { border-top-color: color-mix(in srgb, var(--cream) 30%, transparent); }
    .has-js nav { width: 100%; text-align: center; }
    .has-js .menu-toggle[aria-expanded="false"] + nav { display: none; }
    .has-js .nav { flex-direction: column; gap: 0; padding-block: var(--space-1); }
    .has-js .nav li + li { border-top: 1px solid var(--hairline); }
    .has-js .nav a { padding-block: 0.75rem; }
  }
</style>
