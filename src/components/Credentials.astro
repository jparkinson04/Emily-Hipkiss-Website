---
/* Qualifications, training and BACP membership, as supplied by Emily. */
interface Props { heading?: string }
const { heading = 'Qualifications & Training' } = Astro.props;
---
<div class="credentials">
  <h2>{heading}</h2>
  <ul>
    <li>MA Integrative Counselling (Level 7)</li>
    <li>BSc Psychology</li>
    <li>Walk &amp; Talk therapy</li>
    <li>Training in working with traumatic bereavement</li>
    <li>Training in working with ADHD and autism</li>
    <li>Training in building anti-racist practice</li>
    <li>Commitment to ongoing professional development</li>
  </ul>
  <p class="credentials__bacp">
    <a href="https://www.bacp.co.uk" rel="noopener">
      <img src="/images/bacp-registered-member-407026.png" alt="BACP Registered Member 407026" width="820" height="366" loading="lazy" />
    </a>
    <span>Registered member (MBACP) working towards accreditation. Registration number 407026.</span>
  </p>
</div>

<style>
  ul { padding-left: 1.2em; margin: 0 0 var(--space-3); }
  li { margin-bottom: 0.35em; }
  .credentials__bacp { display: flex; align-items: center; gap: var(--space-2); max-width: var(--measure); }
  .credentials__bacp a { flex: none; display: block; width: 7.5rem; line-height: 0; }
  .credentials__bacp img { width: 100%; height: auto; border-radius: 0; }
  .credentials__bacp span { font-size: 1rem; }
</style>
