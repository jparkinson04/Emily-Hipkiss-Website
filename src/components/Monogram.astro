---
/* EH monogram. Playfair italic, warm brown. Replace with the final vector when the logo is signed off. */
interface Props { size?: number; title?: string }
const { size = 44, title = 'Emily Hipkiss' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <circle cx="32" cy="32" r="30" fill="none" stroke="var(--sage-deep)" stroke-width="1.5" />
  <text x="32" y="41" text-anchor="middle" style="font-family: var(--font-heading)" font-style="italic" font-size="26" fill="var(--bark-soft)">EH</text>
</svg>
