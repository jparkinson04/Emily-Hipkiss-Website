---
/* Decorative layered hills, echoing the home hero. Absolutely fills its parent (which needs position: relative;
   overflow: hidden). tone="sage" for light backgrounds, tone="cream" for sage/brown ones. soft halves the strength. */
interface Props { tone?: 'sage' | 'cream'; sun?: boolean; soft?: boolean; class?: string }
const { tone = 'sage', sun = false, soft = false, class: cls = '' } = Astro.props;
---
<svg class:list={['hills', `hills--${tone}`, { 'hills--soft': soft }, cls]} viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {sun && <circle class="hills__sun" cx="720" cy="300" r="230" />}
  <path class="hills__hill hills__hill--far" d="M0 470 C 200 400 380 430 560 455 S 900 380 1120 420 S 1340 440 1440 410 V700 H0Z" />
  <path class="hills__hill hills__hill--mid" d="M0 540 C 180 500 330 560 540 530 S 860 480 1060 525 S 1320 560 1440 510 V700 H0Z" />
  <path class="hills__hill hills__hill--near" d="M0 620 C 220 580 420 640 660 610 S 1020 590 1200 625 S 1380 630 1440 605 V700 H0Z" />
</svg>

<style>
  .hills { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; border-radius: inherit; --k: 1; }
  .hills--soft { --k: 0.5; }

  .hills--sage .hills__sun { fill: var(--cream); opacity: calc(0.7 * var(--k)); }
  .hills--sage .hills__hill--far { fill: var(--sage); opacity: calc(0.3 * var(--k)); }
  .hills--sage .hills__hill--mid { fill: var(--sage); opacity: calc(0.55 * var(--k)); }
  .hills--sage .hills__hill--near { fill: var(--sage-deep); opacity: calc(0.45 * var(--k)); }

  .hills--cream .hills__sun { fill: var(--cream); opacity: calc(0.08 * var(--k)); }
  .hills--cream .hills__hill--far { fill: var(--cream); opacity: calc(0.1 * var(--k)); }
  .hills--cream .hills__hill--mid { fill: var(--cream); opacity: calc(0.14 * var(--k)); }
  .hills--cream .hills__hill--near { fill: var(--cream); opacity: calc(0.2 * var(--k)); }

  /* Gentle rise on load, matching the home hero feel */
  @media (prefers-reduced-motion: no-preference) {
    .hills__hill { animation: hill-rise 1.1s cubic-bezier(.2,.7,.2,1) both; }
    .hills__hill--mid { animation-delay: 0.12s; }
    .hills__hill--near { animation-delay: 0.24s; }
    @keyframes hill-rise { from { transform: translateY(48px); } to { transform: translateY(0); } }
  }
</style>
