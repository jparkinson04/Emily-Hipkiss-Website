---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__name">Emily Hipkiss BSc MA</p>
      <p>BACP Registered Psychotherapist<br />Registered member (MBACP) 407026</p>
      <a class="site-footer__badge" href="https://www.bacp.co.uk" rel="noopener">
        <img src="/images/bacp-registered-member-407026.png" alt="BACP Registered Member 407026" width="820" height="366" loading="lazy" />
      </a>
    </div>
    <div>
      <ul class="site-footer__contact">
        <li><svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6.5L20.5 7" /></svg><a href="mailto:emilyhipkisscounselling@outlook.com">emilyhipkisscounselling@outlook.com</a></li>
        <li><svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z" /></svg><a href="tel:+447712163270">07712 163270</a></li>
        <li><svg class="site-footer__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg><span>Working days: Monday to Thursday</span></li>
      </ul>
    </div>
    <div>
      <p><a href="/privacy">Privacy notice</a></p>
      <p class="site-footer__small">&copy; {year} Emily Hipkiss. Site by <a href="https://seamdigital.co.uk">SEAM</a>.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--stone-light); border-top: 4px solid var(--sage); border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding-block: var(--space-5) var(--space-4); font-size: 1rem; }
  .site-footer__grid { display: grid; gap: var(--space-3) var(--space-4); }
  @media (min-width: 761px) { .site-footer__grid { grid-template-columns: repeat(3, 1fr); } }
  .site-footer__name { font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: var(--space-1); }
  /* --sage-deep and --muted both fall short of 4.5:1 on --stone-light, so the footer uses the browns. */
  .site-footer a { color: var(--bark); overflow-wrap: anywhere; }
  .site-footer a:hover { color: var(--sage-deep); }
  .site-footer__small { color: var(--bark-soft); font-size: 0.9375rem; }
  .site-footer__contact { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .site-footer__contact li { display: flex; align-items: flex-start; gap: 0.6rem; }
  .site-footer__icon { flex: none; width: 1.25rem; height: 1.25rem; margin-top: 0.15em; fill: none; stroke: var(--sage-deep); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .site-footer__badge { display: block; width: 8.5rem; line-height: 0; }
  .site-footer__badge img { width: 100%; height: auto; border-radius: 0; }
  @media (max-width: 760px) {
    .site-footer { padding-block: 32px 24px; font-size: 0.9375rem; }
    .site-footer__grid { gap: var(--space-3); }
    .site-footer p { margin-bottom: 0.4rem; }
    .site-footer__name { font-size: 1.125rem; margin-bottom: 0.25rem; }
    .site-footer__badge { width: 7rem; margin-top: 0.5rem; }
    .site-footer__contact { gap: 0.4rem; }
  }
</style>
