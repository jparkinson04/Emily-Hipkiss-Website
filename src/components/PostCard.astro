---
/* Blog card: image on top, details below. Without an image it shows a soft sage panel with the monogram motif. */
interface Props {
  title: string;
  description: string;
  href?: string;
  date?: Date | string;
  image?: string;
}
const { title, description, href, date, image } = Astro.props;
const dateLabel = date instanceof Date
  ? date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : date;
---
<article class="post-card">
  <div class="post-card__media">
    {image
      ? <img src={image} alt="" loading="lazy" />
      : (
        <svg viewBox="0 0 320 180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <circle cx="160" cy="90" r="62" />
          <circle cx="160" cy="90" r="42" />
          <text x="160" y="99" text-anchor="middle">EH</text>
        </svg>
      )}
  </div>
  <div class="post-card__body">
    {dateLabel && <p class="post-card__date">{dateLabel}</p>}
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    <p>{description}</p>
    <span class="post-card__more" aria-hidden="true">Read article</span>
  </div>
</article>

<style>
  .post-card { position: relative; display: flex; flex-direction: column; background: var(--sage-tint); border-radius: var(--radius); overflow: hidden; transition: background .2s; }
  .post-card__media { aspect-ratio: 16 / 9; background: var(--sage); }
  .post-card__media img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
  .post-card__media svg { width: 100%; height: 100%; display: block; }
  .post-card__media circle { fill: none; stroke: var(--cream); stroke-width: 1; opacity: 0.55; }
  .post-card__media text { font-family: var(--font-heading); font-style: italic; font-size: 26px; fill: var(--cream); opacity: 0.8; }
  .post-card__body { display: flex; flex-direction: column; flex: 1; padding: var(--space-3); border-top: 3px solid var(--sage-deep); }
  .post-card__date { font-size: 0.8125rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--bark-soft); margin-bottom: var(--space-1); }
  h3 { margin-bottom: var(--space-1); }
  h3 a { text-decoration: none; color: var(--bark); }
  /* Whole card is the click target */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .post-card__body p:not(.post-card__date) { font-size: 1rem; }
  .post-card__more { margin-top: auto; padding-top: var(--space-1); font-size: 1rem; font-weight: 600; color: var(--bark); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .post-card:has(a:hover) { background: var(--stone-light); }
  .post-card:has(a:focus-visible) { outline: 3px solid var(--sage-deep); outline-offset: 3px; }
  h3 a:focus-visible { outline: none; }
</style>
