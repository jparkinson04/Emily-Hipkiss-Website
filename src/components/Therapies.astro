---
/* The three ways Emily works, as she listed them. */
interface Props { heading?: string }
const { heading = 'How we can work together' } = Astro.props;
---
<div class="therapies">
  <h2>{heading}</h2>
  <ul>
    <li>In-person sessions in Pontefract</li>
    <li>Video &amp; telephone</li>
    <li><a href="/outdoor-therapy">Walk &amp; Talk outdoor therapy</a></li>
  </ul>
</div>

<style>
  ul { padding-left: 1.2em; margin: 0; }
  li { margin-bottom: 0.5em; }
</style>
