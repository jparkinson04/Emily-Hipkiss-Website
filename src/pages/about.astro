---
import Base from '../layouts/Base.astro';
import AboutTabs from '../components/AboutTabs.astro';
import Hills from '../components/Hills.astro';
import DetailCard from '../components/DetailCard.astro';
// placeholder copy (built from Emily's About wording; confirm with her)
const description = 'Emily Hipkiss is an integrative counsellor and psychotherapist in Pontefract offering a warm, collaborative, relational approach, with a specialism in supporting neurodivergent adults.';
---
<Base title="About" description={description}>
  <div class="about">

    <section class="about-hero">
      <Hills tone="sage" soft />
      <div class="container about-hero__row">
        <div class="about-hero__photo" role="img" aria-label="Portrait of Emily Hipkiss (photograph to come)"><span aria-hidden="true">Portrait photo</span></div>
        <div class="about-hero__text">
          <h1>Therapy that meets you where you are</h1>
          <p class="about-hero__lede">You deserve a space where you can feel heard, understood, and accepted just as you are.</p>
          <p>I'm Emily, an integrative counsellor and psychotherapist. I offer a warm and collaborative approach to therapy, helping you make sense of your experiences, develop a deeper understanding of yourself, and find ways forward that work for you.</p>
          <p>My approach to therapy is relational, which means that the working relationship we build is at the heart of our work together. Therapy works best when you feel safe enough to be open, honest, and explore at your own pace.</p>
          <p>I pride myself on developing an accessible and inclusive practice where you can be exactly who you are without fear of judgment.</p>
        </div>
      </div>
    </section>

    <section class="about-tabs">
      <AboutTabs />
    </section>

    <section class="facts">
      <div class="container">
        <h2 class="facts__title">The practical details</h2>
        <div class="facts__grid detail-grid">

          <DetailCard title="Qualifications & Training">
            <ul>
              <li>MA Integrative Counselling (Level 7)</li>
              <li>BSc Psychology</li>
              <li>Walk &amp; Talk therapy</li>
              <li>Training in working with traumatic bereavement</li>
              <li>Training in working with ADHD and autism</li>
              <li>Training in building anti-racist practice</li>
              <li>Commitment to ongoing professional development</li>
            </ul>
            <p class="detail__foot facts__bacp">
              <a href="https://www.bacp.co.uk" rel="noopener"><img src="/images/bacp-registered-member-407026.png" alt="BACP Registered Member 407026" width="820" height="366" loading="lazy" /></a>
              <span>Registered member (MBACP) working towards accreditation. Registration number 407026.</span>
            </p>
          </DetailCard>

          <DetailCard title="Sessions and fees">
            <ul>
              <li>£60 per session</li>
              <li>Block of 6 weekly sessions for £300</li>
              <li>Limited concession slots for those on lower incomes</li>
              <li>I understand that therapy is an investment and can therefore accommodate fortnightly sessions to spread the cost</li>
              <li><strong>Free 20-minute consultation call via phone or video</strong></li>
            </ul>
          </DetailCard>

          <DetailCard title="How we can work together">
            <ul>
              <li>In-person sessions in Pontefract</li>
              <li>Video &amp; telephone</li>
              <li><a href="/outdoor-therapy">Walk &amp; Talk outdoor therapy</a></li>
              <li>Working days: Monday to Thursday</li>
            </ul>
            <p class="detail__foot"><a class="btn" href="/contact">Get in touch</a></p>
          </DetailCard>

        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  /* 17px body on this page only, to suit the two-column measure */
  .about { font-size: 17px; }
  .about p { max-width: none; }

  .about-hero { position: relative; overflow: hidden; margin: var(--space-2) var(--space-2) 0; border-radius: var(--radius-lg); padding: 56px 0 72px; background: linear-gradient(var(--cream), var(--sage-tint)); }
  .about-hero__row { position: relative; z-index: 1; }
  .about-hero__row { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .about-hero__photo { flex: none; width: 260px; aspect-ratio: 1 / 1; border-radius: 50%; background: var(--stone); display: grid; place-items: center; color: var(--bark-soft); font-size: 0.9375rem; }
  .about-hero__text { flex: 999 1 560px; min-width: 0; max-width: 40rem; }
  .about-hero__lede { font-size: 21px; line-height: 1.5; color: var(--bark-soft); margin-bottom: var(--space-3); }
  .about-hero__text p:not(.about-hero__lede) { margin: 0 0 14px; }
  .about-hero__text p:last-child { margin-bottom: 0; }

  .about-tabs { padding: var(--space-4) 0 48px; }

  .facts { padding: 56px 0 64px; }
  .facts__title { font-size: 40px; margin-bottom: 28px; }
  .facts__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto 1fr; gap: 28px; align-items: stretch; }
  .facts__bacp { display: flex; align-items: center; gap: 14px; margin: 0; }
  .facts__bacp a { flex: none; display: block; width: 88px; line-height: 0; }
  .facts__bacp img { width: 100%; height: auto; border-radius: 0; }
  .facts__bacp span { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .facts :global(.detail__foot .btn) { font-size: 1rem; }

  @media (max-width: 900px) {
    .facts__grid { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 700px) {
    .about-hero { padding: 40px 0 32px; }
    .about-hero__row { justify-content: center; }
  }
</style>
