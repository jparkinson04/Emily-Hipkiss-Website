---
import Base from '../layouts/Base.astro';
import AboutTabs from '../components/AboutTabs.astro';
import Credentials from '../components/Credentials.astro';
import Therapies from '../components/Therapies.astro';
import Fees from '../components/Fees.astro';
// placeholder copy (built from Emily's About wording; confirm with her)
const description = 'Emily Hipkiss is an integrative counsellor and psychotherapist in Pontefract offering a warm, collaborative, relational approach, with a specialism in supporting neurodivergent adults.';
---
<Base title="About" description={description}>
  <div class="about">

    <section class="about-hero">
      <div class="container about-hero__row">
        <div class="about-hero__photo" role="img" aria-label="Portrait of Emily Hipkiss (photograph to come)"><span aria-hidden="true">Portrait photo</span></div>
        <div class="about-hero__text">
          <h1>Therapy that meets you where you are</h1>
          <p class="about-hero__lede">You deserve a space where you can feel heard, understood, and accepted just as you are.</p>
          <p>I'm Emily, an integrative counsellor and psychotherapist. I offer a warm and collaborative approach to therapy, helping you make sense of your experiences, develop a deeper understanding of yourself, and find ways forward that work for you.</p>
          <p>My approach to therapy is relational, which means that the working relationship we build is at the heart of our work together. Therapy works best when you feel safe enough to be open, honest, and explore at your own pace.</p>
          <p>I pride myself on developing an accessible and inclusive practice where you can be exactly who you are without fear of judgment.</p>
        </div>
      </div>
    </section>

    <section class="about-tabs">
      <div class="container">
        <AboutTabs />
        <div class="about-cta">
          <p class="about-cta__text"><em>If you'd like to find out more about working together, please get in touch.</em></p>
          <a class="btn" href="/contact">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="facts">
      <div class="container">
        <h2 class="facts__title">The practical details</h2>
        <div class="facts__grid">
          <div class="facts__card facts__card--creds"><Credentials /></div>
          <div class="facts__card facts__card--fees"><Fees /></div>
          <div class="facts__card facts__card--ways">
            <Therapies />
            <a class="btn facts__cta" href="/contact">Get in touch</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  /* 17px body on this page only, to suit the two-column measure */
  .about { font-size: 17px; }
  .about p { max-width: none; }

  .about-hero { padding: 56px 0 44px; }
  .about-hero__row { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .about-hero__photo { flex: none; width: 260px; aspect-ratio: 1 / 1; border-radius: 50%; background: var(--stone); display: grid; place-items: center; color: var(--bark-soft); font-size: 0.9375rem; }
  .about-hero__text { flex: 999 1 560px; min-width: 0; max-width: 40rem; }
  .about-hero__lede { font-size: 21px; line-height: 1.5; color: var(--bark-soft); margin-bottom: var(--space-3); }
  .about-hero__text p:not(.about-hero__lede) { margin: 0 0 14px; }
  .about-hero__text p:last-child { margin-bottom: 0; }

  .about-tabs { padding-bottom: 48px; }
  .about-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: var(--space-4); }
  .about-cta__text { font-family: var(--font-heading); font-size: 22px; margin: 0; }

  .facts { border-top: 1px solid var(--hairline-mid); padding: 56px 0 64px; }
  .facts__title { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-bottom: var(--space-3); }
  .facts__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); align-items: stretch; }
  .facts__card { background: var(--stone-light); border: 1px solid var(--sage); border-radius: var(--radius); padding: 28px 28px 32px; }
  .facts__card :global(h2) { font-size: 1.375rem; margin-bottom: var(--space-2); padding-bottom: var(--space-2); border-bottom: 1px solid var(--sage); }
  .facts :global(ul) { list-style: none; padding: 0; margin: 0; }
  .facts :global(li) { position: relative; font-size: 1rem; line-height: 1.45; padding: 0 0 0 22px; margin: 0; }
  .facts :global(li + li) { margin-top: 10px; }
  .facts :global(li)::before { content: ''; position: absolute; left: 2px; top: 0.5em; width: 9px; height: 9px; border-radius: 50%; background: var(--sage); }
  .facts :global(li a) { color: var(--bark); text-decoration-color: var(--sage-deep); }
  .facts :global(li a:hover) { color: var(--sage-deep); }
  .facts :global(.credentials__bacp) { margin-top: 24px; }
  .facts :global(.credentials__bacp span) { font-size: 0.9375rem; line-height: 1.4; }
  .facts :global(.fees__call) { background: var(--cream); font-size: 1rem; padding: 14px 16px; margin-bottom: var(--space-2); }
  .facts__cta { margin-top: 24px; }

  @media (max-width: 900px) {
    .facts__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .about-hero { padding: 40px 0 32px; }
    .about-hero__row { justify-content: center; }
  }
</style>
