---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Hills from '../components/Hills.astro';
const description = 'Contact Emily Hipkiss, BACP registered counsellor in Pontefract, to enquire about sessions or book a free 20-minute consultation call. In-person, video, telephone and Walk & Talk.';

// Sage panel slides in from the left on the way in, and back out on the way out
const slide = {
  old: { name: 'sageOut', duration: '0.5s', easing: 'cubic-bezier(.7,0,.2,1)', fillMode: 'forwards' },
  new: { name: 'sageIn',  duration: '0.7s', easing: 'cubic-bezier(.7,0,.2,1)', fillMode: 'backwards' },
};
const sageSlide = { forwards: slide, backwards: slide };
---
<Base title="Contact" description={description} page="contact">
  <div class="contact">
    <section class="contact-left" transition:name="sage" transition:animate={sageSlide}>
      <Hills tone="cream" soft />
      <div class="contact-left__intro rise rise--1">
        <h1>Whenever you're ready.</h1>
      </div>
      <div class="contact-more">
        <p class="contact-left__text rise rise--1">Whether you'd like to enquire about sessions or simply have a question, you're welcome to get in touch. Send a message here, or email or call, and I'll reply on one of my working days.</p>
        <h2 class="contact-more__title">Or reach me directly</h2>
        <dl class="contact-left__details rise rise--2">
          <div><dt>Email</dt><dd><a href="mailto:emilyhipkisscounselling@outlook.com">emilyhipkisscounselling@outlook.com</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+447712163270">07712 163270</a></dd></div>
          <div><dt>Working days</dt><dd>Monday to Thursday</dd></div>
          <div><dt>Sessions</dt><dd>In person in Pontefract, by video or phone, or <a class="contact-left__link" href="/outdoor-therapy">Walk &amp; Talk</a></dd></div>
        </dl>
        <p class="contact-more__next">We'll start with a free 20-minute consultation call by phone or video.</p>
      </div>
    </section>
    <section class="contact-right rise rise--3" aria-label="Contact form">
      <ContactForm />
    </section>
  </div>
</Base>

<style>
  .contact { display: flex; flex-wrap: wrap; min-height: 100vh; flex: 1; }

  /* Desktop: sage left half, form right half (unchanged) */
  .contact-left {
    position: relative; overflow: hidden;
    flex: 1 1 520px; min-width: 0; background: var(--sage-deep); color: var(--cream);
    padding: 150px 56px 56px; display: flex; flex-direction: column; gap: 24px;
  }
  .contact-left > :not(.hills) { position: relative; z-index: 1; }
  .contact-more { display: contents; }
  .contact-left h1 { color: var(--cream); font-size: clamp(48px, 6vw, 84px); line-height: 1.05; margin: 0; }
  .contact-left__text { position: relative; z-index: 1; color: var(--cream); font-size: 20px; line-height: 1.5; max-width: 560px; margin: 0; }
  .contact-more__title, .contact-more__next { display: none; }
  .contact-left__details {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; margin: auto 0 0;
    padding-top: 28px; border-top: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .contact-left__details dt { font-size: 0.9375rem; opacity: .8; margin-bottom: 4px; }
  .contact-left__details dd { margin: 0; overflow-wrap: anywhere; }
  .contact-left__details a { color: var(--cream); text-decoration: none; }
  .contact-left__details a:hover { text-decoration: underline; }
  .contact-left__details .contact-left__link { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .contact-left :focus-visible { outline-color: var(--cream); }

  .contact-right { flex: 1 1 520px; min-width: 0; padding: 150px 72px 72px; display: flex; align-items: center; }

  /* Phones and small tablets: sage headline, overlapping form card, then a stone strip of contact details */
  @media (max-width: 900px) {
    .contact { flex-direction: column; min-height: 0; }
    .contact-left { display: contents; }
    .contact-left :global(.hills) { display: none; }
    .contact-left__intro { order: 1; flex: none; background: var(--sage-deep); color: var(--cream); padding: 128px 24px 84px; }
    .contact-left h1 { font-size: 38px; }
    .contact-right { order: 2; flex: none; margin: -60px 16px 0; padding: 24px 20px; background: var(--cream); border-radius: var(--radius); position: relative; z-index: 1; display: block; }
    .contact-more { order: 3; flex: none; display: block; background: var(--stone-light); margin: 24px 16px 0; padding: 24px 20px 28px; border-radius: var(--radius); color: var(--bark); }
    .contact-left__text { color: var(--bark); font-size: 1.0625rem; margin: 0 0 20px; }
    .contact-more__title { display: block; font-size: 1.375rem; margin: 0 0 4px; }
    .contact-left__details { display: block; margin: 0; padding: 0; border: 0; }
    .contact-left__details div { display: block; min-height: 48px; padding: 9px 0; border-top: 1px solid var(--hairline-mid); }
    .contact-left__details div:first-child { border-top: 0; }
    .contact-left__details dt { font-size: 0.75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--sage-deep); opacity: 1; margin: 0 0 2px; }
    .contact-left__details dd { font-size: 1rem; }
    .contact-left__details a { color: var(--bark); }
    .contact-left__details .contact-left__link { text-decoration-color: var(--sage-deep); }
    .contact-more__next { display: block; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--hairline-mid); font-size: 0.9375rem; color: var(--bark-soft); }
    .contact :focus-visible { outline-color: var(--sage-deep); }
  }
</style>
